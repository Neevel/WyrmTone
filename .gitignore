# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# IR audio stays external and must never be committed or packaged.
*.[wW][aA][vV]
# ...except the three shipped Tone Match runtime signals (own recordings, exact file names only;
# evaluation/research/dataset WAVs stay ignored).
!assets/tonematch/runtime/wyrmtone-rhythm-v1-t15.wav
!assets/tonematch/runtime/wyrmtone-lead-v1-t15.wav
!assets/tonematch/runtime/wyrmtone-clean-v1-full.wav

# External models, raw device captures, packages and private credentials.
*.[nN][aA][mM]
*.pcap
*.pcapng
*.apk
*.aab
*.zip
.env
.env.*
!.env.example
wyrmtone-captures/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
# Only the pinned NeuralAmpModelerCore git submodule lives in third_party/; any other local content stays ignored.
third_party/*
!third_party/NeuralAmpModelerCore

# Native NAM bridge (V4a): CMake build output and generated test artifacts.
# The C++ source itself (native/nam_bridge/{include,src,tools,CMakeLists.txt})
# is not excluded.
native/*/build/
native/*/out/

# Tone Match research: device review screenshots (private content) and large raw/cache outputs stay local.
tool/tonematch_android_bench/results/review/
tool/tonematch_android_bench/results/ui_screen_*.png
tool/tonematch_*/results/raw.json
tool/tonematch_*/results/*_raw.json
tool/tonematch_reference_match/results/*_features_cache.json
